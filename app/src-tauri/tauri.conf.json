{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dofight",
  "version": "1.18.0",
  "identifier": "app.dofight",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "panel",
        "url": "index.html",
        "title": "Dofight",
        "width": 340,
        "height": 900,
        "minWidth": 240,
        "maxWidth": 600,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "focus": false,
        "acceptFirstMouse": true,
        "resizable": true,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "preview",
        "url": "preview.html",
        "title": "Dofight – Aperçu",
        "width": 320,
        "height": 900,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "acceptFirstMouse": true,
        "resizable": false,
        "transparent": true,
        "shadow": false,
        "focusable": false
      },
      {
        "label": "peek",
        "url": "peek.html",
        "title": "Dofight",
        "width": 320,
        "height": 200,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "acceptFirstMouse": true,
        "resizable": false,
        "transparent": true,
        "shadow": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4MDBBNEYzOEI5NjE4Q0QKUldUTkdKYUw4NlFBR0FjaU5lTmEydGJzS1ZBaVBjT0dkSTRCbENKSHErdnkyMW5DRHNQK0RHMFIK",
      "endpoints": [
        "https://github.com/dofight/dofight/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
